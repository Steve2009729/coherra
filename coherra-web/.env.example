# Coherra Frontend Environment Variables
# Copy to .env.local for development or configure in Vercel project settings

# Privy App ID for authentication
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Coherra Backend API URL (Production Railway/Fly.io URL or local dev server)
NEXT_PUBLIC_COHERRA_API_URL=http://localhost:8080
