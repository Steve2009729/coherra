# Coherra Production Environment Configuration
# Copy this file to .env and fill in the values for local development or set them in your hosting provider (Railway/Fly.io)

# ---------------------------------------------------------------------------
# Backend & Database Configuration
# ---------------------------------------------------------------------------
# Managed Postgres connection string (provided by Railway / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Port for the persistent FastAPI/Starlette x402 server (default: 8080)
PORT=8080

# Allowed CORS origins for the backend (comma-separated, include production frontend URL)
COHERRA_ALLOWED_ORIGINS=https://coherra-web.vercel.app,https://coherra.vercel.app,http://localhost:3000

# ---------------------------------------------------------------------------
# Web3 / x402 Payment Gate Configuration (Base Mainnet)
# ---------------------------------------------------------------------------
# Base Mainnet payout address to receive 0.015 USDC per audit
COHERRA_PAYOUT_ADDRESS=0x1BFAe4EE12c8f2bF17B8EEb8Ea0BcB32AdbB240B

# Base Mainnet JSON-RPC endpoint (defaults to public Base RPC)
COHERRA_BASE_RPC_URL=https://mainnet.base.org

# Base Mainnet USDC Contract Address (Chain ID: 8453)
# 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
COHERRA_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ---------------------------------------------------------------------------
# AI Model APIs (Track 1 Multi-Model Support)
# ---------------------------------------------------------------------------
# Google Gemini (Gemini Flash-Lite 2.5)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI ("Luna" / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# xAI (Grok 4.3 / Grok-2)
XAI_API_KEY=your_xai_api_key_here

# Anthropic (Claude Haiku 4.5 / 3.5 Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

